---
name: test_xor_folding
alignment: 16
tracksRegLiveness: true
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
  - { id: 2, class: gr32 }
body: |
  bb.0:
    liveins: $edi
    ; CHECK: XOR32ri
    %0:gr32 = COPY $edi
    %1:gr32 = MOV32ri -1
    %2:gr32 = XOR32rr killed %0, killed %1, implicit-def dead $eflags
