# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/lyzlova_BACKEND%shlibext \
# RUN: -run-pass=immediate-folding %s -o - | FileCheck %s

---
name: test_add_folding
alignment: 16
tracksRegLiveness: true
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
  - { id: 2, class: gr32 }
body: |
  bb.0:
    liveins: $edi
    ; CHECK: ADD32ri
    %0:gr32 = COPY $edi
    %1:gr32 = MOV32ri 42
    %2:gr32 = ADD32rr killed %0, killed %1, implicit-def dead $eflags
    $eax = COPY %2
    RET64 $eax

---
name: test_sub_folding
alignment: 16
tracksRegLiveness: true
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
  - { id: 2, class: gr32 }
body: |
  bb.0:
    liveins: $edi
    ; CHECK: SUB32ri
    %0:gr32 = COPY $edi
    %1:gr32 = MOV32ri 10
    %2:gr32 = SUB32rr killed %0, killed %1, implicit-def dead $eflags
    $eax = COPY %2
    RET64 $eax

