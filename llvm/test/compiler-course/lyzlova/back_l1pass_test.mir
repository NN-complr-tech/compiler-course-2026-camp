---
name: test_no_fold_unsupported_op
alignment: 16
tracksRegLiveness: true
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
  - { id: 2, class: gr32 }
body: |
  bb.0:
    liveins: $edi
    ; CHECK: MOV32ri 3
    ; CHECK: IMUL32rr
    %0:gr32 = COPY $edi
    %1:gr32 = MOV32ri 3
    %2:gr32 = IMUL32rr killed %0, killed %1, implicit-def dead $eflags
    $eax = COPY %2
    RET64 $eax